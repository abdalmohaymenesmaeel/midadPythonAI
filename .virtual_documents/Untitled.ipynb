#changing State
class Student:
    def __init__(self,name,age):
        self.name=name
        self.age=age
    def printData(self):
        print(f"name:{self.name},age:{self.age}")
    def changeName(self,newName):
        self.name=newName
    def changeAge(self,newAge):
        self.age=newAge


std=Student("mostfa",25)
std.printData()


std.changeName("ahmad")
std.printData()


std.changeAge(23)
std.printData()


