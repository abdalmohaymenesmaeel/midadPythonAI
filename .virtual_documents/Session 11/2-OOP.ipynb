class Employee:
    def __init__(self,name,salary):
        self.name=name
        self.salary=salary
    def printData(self):
        print(f"{self.name},{self.salary}")
    #printData is instance method
    #self.printData() , emp.printData()
    @staticmethod
    def sumSalaries(lst):
        total=0
        for employee in lst:
            total+=employee.salary
        return total
    #static method Employee.sumSalaries(lst)


emp1=Employee("ahmad",320)
emp2=Employee("sameer",120)
emp3=Employee("khalid",520)
emp4=Employee("omar",220)
emp5=Employee("mahmoud",420)
lst=[emp1,emp2,emp3,emp4,emp5]
Employee.sumSalaries(lst)


class Employee:
    def __init__(self,name,salary):
        self.name=name
        self.salary=salary
    def printData(self):
        print(f"{self.name},{self.salary}")
    #printData is instance method
    #self.printData() , emp.printData()
    @classmethod
    def sumSalaries(cls,lst):
        total=0
        for employee in lst:
            total+=employee.salary
        return total
    #static method Employee.sumSalaries(lst)
emp1=Employee("ahmad",320)
emp2=Employee("sameer",120)
emp3=Employee("khalid",520)
emp4=Employee("omar",220)
emp5=Employee("mahmoud",420)
lst=[emp1,emp2,emp3,emp4,emp5]
Employee.sumSalaries(lst)


